# KSI-CCTV environment template
# Copy to .env locally if needed. Do not commit real credentials.
# Production/systemd deployments may copy a site-specific file to
# /etc/ksi-cctv/ksi-cctv.env with owner-readable permissions only.

# Engine authentication is required. Web authentication is optional. If the web password is
# empty, UI first-use setup still requires a separate 32+ character bootstrap token.
KSI_CCTV_API_KEY=replace-with-random-api-key
KSI_CCTV_WEB_PASSWORD=
# Set at least 32 high-entropy characters whenever KSI_CCTV_WEB_PASSWORD is set.
KSI_CCTV_WEB_SECRET=
# Set at least 32 high-entropy characters only when UI-managed first-use setup is required.
KSI_CCTV_WEB_SETUP_TOKEN=
# Fernet key for encrypted evidence captures. Generate per site with:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Required when alerts.save_images=true (the secure default).
KSI_CCTV_CAPTURE_KEY=replace-with-site-fernet-key
# 300초~2592000초(30일). 미설정 시 43200초(12시간).
KSI_CCTV_WEB_SESSION_TTL_SEC=43200
# Set true only when the console is served through HTTPS.
KSI_CCTV_WEB_COOKIE_SECURE=false
# Caddy/nginx 같은 신뢰 가능한 역프록시 뒤에서만 true.
KSI_CCTV_TRUST_PROXY=false
# Literal 1 enables login bypass only through the guarded loopback launcher and its one-time browser URL.
# Local-only example:
# KSI_CCTV_WEB_DEV=1 KSI_CCTV_DEV_AUTH_BYPASS=1 bash scripts/run_web.sh
KSI_CCTV_DEV_AUTH_BYPASS=0

# RTSP camera URLs. Local video files are also supported for testing.
# Replace all user/password placeholders before production use.
CCTV_CAM_001_URL=rtsp://user:password@192.168.1.101:554/stream1
CCTV_CAM_002_URL=rtsp://user:password@192.168.1.102:554/stream1
CCTV_CAM_003_URL=./data/sample.mp4

# SMTP notification (optional)
# Leave unset if SMTP is not used. Do not commit real SMTP credentials.
KSI_CCTV_SMTP_HOST=smtp.example.com
KSI_CCTV_SMTP_PORT=587
KSI_CCTV_SMTP_USER=alerts@example.com
KSI_CCTV_SMTP_PASSWORD=change-me
KSI_CCTV_SMTP_RECIPIENTS=admin@example.com
