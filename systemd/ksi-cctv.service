[Unit]
Description=KSI-CCTV headless detection daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Site-specific values: create this user/group and install the project at
# WorkingDirectory, or adjust all three values for the target deployment.
# install.sh가 WorkingDirectory/User/Group/ExecStart/ReadWritePaths 를 일괄 치환한다.
User=ksi-cctv
Group=ksi-cctv
WorkingDirectory=/opt/ksi-cctv
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Seoul
# 비밀/환경 파일 — install.sh가 생성하는 프로젝트 .env를 가리킨다(존재하지 않아도 무방: '-').
# run.py도 WorkingDirectory의 .env를 직접 로드하므로 이중으로 보장된다.
# (이전 /etc/ksi-cctv/ksi-cctv.env는 install.sh가 생성하지 않아 비번 미주입→crash-loop의 원인이었음.)
EnvironmentFile=-/opt/ksi-cctv/.env
# 무인 탐지 데몬을 직접 실행 — 대시보드 버튼 없이 파이프라인 자동 기동 + /health(8081) 제공.
# (install.sh가 .venv 경로와 INSTALL_DIR을 치환한다.)
ExecStart=/opt/ksi-cctv/.venv/bin/python /opt/ksi-cctv/src/run.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Minimal hardening while preserving required runtime write paths.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# install.sh가 /opt/ksi-cctv 를 실제 설치 경로($(pwd))로 함께 치환한다.
# 아래 경로들도 치환되므로 설치 후 경로 불일치 없음.
ReadWritePaths=/opt/ksi-cctv/logs /opt/ksi-cctv/data /opt/ksi-cctv/models/uploaded /opt/ksi-cctv/config/model_profiles.yaml

[Install]
WantedBy=multi-user.target
