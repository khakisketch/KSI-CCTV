# KSI-CCTV 프론트엔드 환경변수 (서버 전용 — NEXT_PUBLIC_ 아님, 브라우저 미노출)
# 복사: cp .env.example .env.local  후 값 설정. 운영은 배포 시 환경변수로 주입 권장.

# 엔진 API 위치(헤드리스 엔진 FastAPI). 같은 호스트면 기본값.
KSI_CCTV_ENGINE_URL=http://127.0.0.1:8000

# 엔진 API 키(엔진의 KSI_CCTV_API_KEY와 동일) — 서버사이드에서만 사용, 브라우저 미노출.
KSI_CCTV_API_KEY=change-me-engine-key

# 선택: 설정하면 환경변수 관리 로그인 보호를 강제한다. 비워두면 콘솔은 공개 상태지만
# 임의의 원격 사용자가 보호를 선점하지 못하도록 Settings의 최초 설정에는 별도 token이 필요하다.
KSI_CCTV_WEB_PASSWORD=

# 환경변수 로그인 보호를 쓸 때만 32자 이상인 별도의 고엔트로피 session secret을 반드시 설정한다.
KSI_CCTV_WEB_SECRET=

# UI 관리 최초 보호 설정용 32자 이상 고엔트로피 bootstrap token. 설정 후 제거한다.
KSI_CCTV_WEB_SETUP_TOKEN=

# 로그인 세션 수명(300초~30일). 기본 43200초(12시간).
KSI_CCTV_WEB_SESSION_TTL_SEC=43200

# 정확히 1일 때 보호된 loopback launcher + 일회용 browser capability에서만 허용.
# 직접 next dev/build/start/Docker/외부 bind 및 capability 없는 proxy 요청은 fail-closed.
KSI_CCTV_DEV_AUTH_BYPASS=0
KSI_CCTV_WEB_BIND_HOST=127.0.0.1

# 영상 게이트웨이(MediaMTX) 주소 — 프론트 "서버"에서 도달 가능한 주소(브라우저 아님).
# HLS는 same-origin 프록시(/api/cameras/{id}/hls/...)를 통하므로 게이트웨이 주소는 서버 전용이며
# 브라우저에 노출되지 않는다. compose에서는 서비스명(http://ksi-cctv-gateway:8888)이 적합.
# 미설정 시 카메라 페이지 "라이브 보기"는 503(게이트웨이 미설정)으로 graceful 처리된다.
KSI_CCTV_GATEWAY_URL=http://localhost:8888
